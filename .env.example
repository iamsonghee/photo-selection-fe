# Supabase (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
# 서버 전용. 고객 플로우 API Route에서 selections 등 RLS 우회용. 절대 클라이언트 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=

# 백엔드 API (미설정 시 http://localhost:8000)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# 고객 프리뷰(뷰어) 이미지: 우클릭·드래그 저장 완화. 베타에서는 보통 미설정(저장 허용).
# 상용에서 다시 막을 때만 true
# NEXT_PUBLIC_BLOCK_VIEWER_IMAGE_DOWNLOAD=true

NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: run `npm run supabase:sync-production-auth-urls` (needs Supabase PAT: auth_config_read + auth_config_write)
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=

# 컬러칩 color_tags 배열 전환(20260729 마이그레이션) 관련 — 레거시 color_tag(전체교체) 필드를
# POST /api/c/selections에서 400으로 거부할지 여부. 마이그레이션 직후 배포 전환 구간에는
# 구버전 탭의 저장이 DB 트리거를 통해 안전히 동기화되어야 하므로 반드시 미설정(또는 false) 유지.
# 신버전이 완전히 롤아웃되고 레거시 color_tag 쓰기가 0건임을 운영에서 확인한 뒤에만 true로 전환.
# REJECT_LEGACY_COLOR_TAG=true
